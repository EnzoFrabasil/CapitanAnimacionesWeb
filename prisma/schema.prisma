// Esquema de la base de datos de inscripciones de la colonia.
//
// A futuro se van a agregar Pase, Pago, Descuento, Comprobante y Tarifa.
// Esas tablas solo van a sumar relaciones nuevas a las de acá (por ejemplo
// Pago -> Familia, Pase -> InscripcionNino, Tarifa -> Temporada), sin
// modificar las columnas existentes.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// SEMANAS = por opciones de inscripción (ver Semana); POR_DIA = días sueltos.
enum Modalidad {
  SEMANAS
  POR_DIA
}

// Descuento por hermanos de una familia: AUTOMATICO lo aplica si hay 2 o más
// chicos inscriptos en la temporada; SI / NO lo fuerzan desde el panel.
enum DescuentoHermanos {
  AUTOMATICO
  SI
  NO
}

enum EstadoInscripcion {
  EN_ESPERA
  CONFIRMADO
  CANCELADO
}

// Agrupa hermanos (para el descuento por hermanos).
model Familia {
  id                Int               @id @default(autoincrement())
  descuentoHermanos DescuentoHermanos @default(AUTOMATICO)
  createdAt         DateTime          @default(now())

  ninos         Nino[]
  inscripciones Inscripcion[]
}

model Nino {
  id              Int      @id @default(autoincrement())
  familiaId       Int
  nombre          String
  apellido        String
  // Solo dígitos. No es único: los duplicados se marcan, no se rechazan.
  dni             String
  fechaNacimiento DateTime @db.Date
  infoAdicional   String?  @db.Text
  createdAt       DateTime @default(now())

  familia       Familia           @relation(fields: [familiaId], references: [id])
  responsables  NinoResponsable[]
  inscripciones InscripcionNino[]

  @@index([familiaId])
  @@index([dni])
}

model Responsable {
  id          Int      @id @default(autoincrement())
  nombre      String
  apellido    String
  // Formato E.164 de móvil argentino (+549...).
  whatsapp    String   @unique
  whatsappAlt String?
  email       String?
  // Existe en la base pero no se pide en el formulario por ahora.
  dni         String?
  createdAt   DateTime @default(now())

  ninos                  NinoResponsable[]
  inscripcionesPrincipal Inscripcion[]
}

model NinoResponsable {
  ninoId        Int
  responsableId Int
  parentesco    String
  esPrincipal   Boolean @default(false)
  orden         Int     @default(0)

  nino        Nino        @relation(fields: [ninoId], references: [id], onDelete: Cascade)
  responsable Responsable @relation(fields: [responsableId], references: [id], onDelete: Cascade)

  @@id([ninoId, responsableId])
  @@index([responsableId])
}

model Temporada {
  id                    Int      @id @default(autoincrement())
  nombre                String
  anio                  Int
  inscripcionAbierta    Boolean  @default(false)
  // Cantidad total de lugares (cada niño inscripto ocupa uno, salvo los cancelados).
  // Se muestra como "quedan N lugares" en la página de inicio. Null = sin cupo.
  cupo                  Int?
  // Edad permitida para inscribirse (años cumplidos al inscribir, inclusive).
  edadMinima            Int      @default(2)
  edadMaxima            Int      @default(17)
  // Inscripción por días sueltos (dentro de las fechas de las opciones).
  permitePorDia         Boolean  @default(false)
  // Precios en pesos. La colonia completa se cobra cuando un chico tiene todas
  // las opciones de su horario; null = se suma el precio de cada opción.
  precioColoniaCompleta Int?
  precioDia             Int?
  // Porcentaje sobre el total de la familia cuando hay 2 o más hermanos.
  descuentoHermanos     Int      @default(10)
  createdAt             DateTime @default(now())

  semanas       Semana[]
  gruposEdad    GrupoEdad[]
  inscripciones Inscripcion[]
}

// Opción de inscripción ("Quincena 1", "Semana 2"...): nombre libre, fechas,
// horario y precio. La familia elige una o varias, todas del mismo horario.
// (La tabla se sigue llamando Semana por historia; en la aplicación son "opciones".)
model Semana {
  id          Int      @id @default(autoincrement())
  temporadaId Int
  // Orden en que se muestran.
  numero      Int
  nombre      String   @default("")
  fechaInicio DateTime @db.Date
  fechaFin    DateTime @db.Date
  // Horario en formato HH:MM (por ejemplo 08:30 y 12:30).
  horaInicio  String   @default("08:30")
  horaFin     String   @default("12:30")
  // Precio en pesos.
  precio      Int      @default(0)
  // Si está desactivada no se ofrece en el formulario (las inscripciones existentes se conservan).
  activa      Boolean  @default(true)

  temporada     Temporada           @relation(fields: [temporadaId], references: [id], onDelete: Cascade)
  inscripciones InscripcionSemana[]
  dias          InscripcionDia[]

  @@unique([temporadaId, numero])
}

// Rangos de edad inclusivos. La no superposición se valida en la aplicación.
model GrupoEdad {
  id          Int    @id @default(autoincrement())
  temporadaId Int
  nombre      String
  edadMin     Int
  edadMax     Int

  temporada Temporada         @relation(fields: [temporadaId], references: [id], onDelete: Cascade)
  ninos     InscripcionNino[]

  @@unique([temporadaId, nombre])
}

// Un formulario enviado (de 1 a 10 niños).
model Inscripcion {
  id                     Int       @id @default(autoincrement())
  // Correlativo visible para humanos (se muestra en la pantalla de éxito).
  numero                 Int       @unique @default(autoincrement())
  temporadaId            Int
  familiaId              Int
  responsablePrincipalId Int
  fechaAlta              DateTime  @default(now())
  // Constancia de que el responsable aceptó las condiciones y la política de
  // privacidad (Ley 25.326), y qué versión del texto aceptó. Null en las
  // inscripciones anteriores a que existiera la casilla.
  privacidadAceptadaEn   DateTime?
  privacidadVersion      String?

  temporada            Temporada         @relation(fields: [temporadaId], references: [id])
  familia              Familia           @relation(fields: [familiaId], references: [id])
  responsablePrincipal Responsable       @relation(fields: [responsablePrincipalId], references: [id])
  ninos                InscripcionNino[]

  @@index([temporadaId, fechaAlta])
  @@index([familiaId])
  @@index([responsablePrincipalId])
}

model InscripcionNino {
  id               Int               @id @default(autoincrement())
  inscripcionId    Int
  ninoId           Int
  // null = "sin grupo" (se asigna a mano o con el botón del panel).
  grupoEdadId      Int?
  edadAlInscribir  Int
  modalidad        Modalidad
  estado           EstadoInscripcion @default(EN_ESPERA)
  posibleDuplicado Boolean           @default(false)
  notasAdmin       String?           @db.Text
  // Precio acordado con la familia (por ejemplo por WhatsApp). Si está cargado
  // reemplaza al que se calcula con los precios de la temporada.
  precioAcordado   Int?

  inscripcion Inscripcion         @relation(fields: [inscripcionId], references: [id], onDelete: Cascade)
  nino        Nino                @relation(fields: [ninoId], references: [id])
  grupoEdad   GrupoEdad?          @relation(fields: [grupoEdadId], references: [id], onDelete: SetNull)
  semanas     InscripcionSemana[]
  dias        InscripcionDia[]

  @@unique([inscripcionId, ninoId])
  @@index([ninoId])
  @@index([grupoEdadId])
  @@index([estado])
}

// Opciones elegidas si la modalidad es SEMANAS.
model InscripcionSemana {
  inscripcionNinoId Int
  semanaId          Int

  inscripcionNino InscripcionNino @relation(fields: [inscripcionNinoId], references: [id], onDelete: Cascade)
  semana          Semana          @relation(fields: [semanaId], references: [id], onDelete: Restrict)

  @@id([inscripcionNinoId, semanaId])
  @@index([semanaId])
}

// Días sueltos si la modalidad es POR_DIA. Cada día pertenece a una opción
// (de ahí sale su horario).
model InscripcionDia {
  inscripcionNinoId Int
  fecha             DateTime @db.Date
  semanaId          Int

  inscripcionNino InscripcionNino @relation(fields: [inscripcionNinoId], references: [id], onDelete: Cascade)
  semana          Semana          @relation(fields: [semanaId], references: [id], onDelete: Restrict)

  @@id([inscripcionNinoId, fecha])
  @@index([fecha])
  @@index([semanaId])
}

// ── Contenido editable de la página de inicio ────────────────────────────────

// Cada vez que un administrador publica la página de inicio se guarda una
// versión nueva (la última es la publicada). Se conservan las últimas para
// poder volver atrás. `datos` sigue el esquema de src/lib/contenido/esquema.ts.
model ContenidoSitio {
  id       Int      @id @default(autoincrement())
  datos    Json
  creadoEn DateTime @default(now())

  @@index([creadoEn])
}

// Imágenes subidas desde el editor de la página de inicio. Se guardan en la
// base (ya achicadas en el navegador) y se sirven desde /imagenes/<id>.
// Son inmutables: cambiar una imagen sube una nueva.
model Imagen {
  id       String   @id @default(cuid())
  tipo     String
  datos    Bytes
  tamano   Int
  creadaEn DateTime @default(now())
}
