# Copiá este archivo como .env y completá los valores. Nunca subas .env al repositorio.

# Neon: cadena de conexión "pooled" (el host contiene "-pooler"). La usa la app.
DATABASE_URL="postgresql://USUARIO:CONTRASENA@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"

# Neon: cadena de conexión directa (sin "-pooler"). La usan las migraciones y el seed.
DIRECT_URL="postgresql://USUARIO:CONTRASENA@HOST.REGION.aws.neon.tech/neondb?sslmode=verify-full"

# Contraseña compartida del panel /admin.
# Si queda vacía: en desarrollo (npm run dev) se entra al panel SIN contraseña;
# en producción (Vercel, next start) el panel queda BLOQUEADO hasta configurarla.
ADMIN_PASSWORD=""

# Secreto para firmar la cookie de sesión: string aleatorio de al menos 32 caracteres
# (por ejemplo: openssl rand -base64 32). Obligatorio si hay ADMIN_PASSWORD.
SESSION_SECRET=""
